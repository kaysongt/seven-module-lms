generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  STUDENT
  INSTRUCTOR
  ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  DECLINED
  WAITLISTED
}

enum EnrollmentStatus {
  ACTIVE
  PAUSED
  COMPLETED
  REVOKED
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LessonKind {
  VIDEO
  READING
  DOWNLOAD
  ASSIGNMENT
}

enum AttemptStatus {
  SUBMITTED
  PASSED
  FAILED
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  NEEDS_REVISION
}

enum PostStatus {
  VISIBLE
  HIDDEN
}

model User {
  id                  String                 @id @default(uuid())
  email               String                 @unique
  fullName            String
  passwordHash        String?
  role                UserRole               @default(STUDENT)
  failedLoginCount    Int                    @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  sessions            Session[]
  invitations         Invitation[]
  enrollments         Enrollment[]
  lessonProgress      LessonProgress[]
  assessmentAttempts  AssessmentAttempt[]
  submissions         AssignmentSubmission[] @relation("StudentSubmissions")
  submissionsReviewed AssignmentSubmission[] @relation("ReviewerSubmissions")
  posts               DiscussionPost[]       @relation("PostAuthor")
  postsModerated      DiscussionPost[]       @relation("PostModerator")
  certificates        Certificate[]          @relation("StudentCertificates")
  certificatesIssued  Certificate[]          @relation("IssuedCertificates")
  announcements       Announcement[]
  auditLogs           AuditLog[]
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Invitation {
  id         String    @id @default(uuid())
  tokenHash  String    @unique
  userId     String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Program {
  id               String         @id @default(uuid())
  slug             String         @unique
  name             String
  shortName        String
  eyebrow          String
  tagline          String
  description      String
  passMark         Int            @default(80)
  certificateLabel String
  isPublished      Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  modules          Module[]
  enrollments      Enrollment[]
  applications     Application[]
  announcements    Announcement[]
  certificates     Certificate[]
}

model Module {
  id               String           @id @default(uuid())
  programId        String
  order            Int
  slug             String
  title            String
  eyebrow          String
  summary          String
  description      String
  objectives       Json
  estimatedMinutes Int              @default(60)
  availableAt      DateTime?
  status           ContentStatus    @default(DRAFT)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  program          Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons          Lesson[]
  assessment       Assessment?
  posts            DiscussionPost[]

  @@unique([programId, order])
  @@unique([programId, slug])
  @@index([programId, status, order])
}

model Lesson {
  id               String                 @id @default(uuid())
  moduleId         String
  order            Int
  slug             String
  title            String
  summary          String
  body             String
  kind             LessonKind             @default(READING)
  videoUrl         String?
  resourceUrl      String?
  estimatedMinutes Int                    @default(15)
  status           ContentStatus          @default(DRAFT)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  module           Module                 @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress         LessonProgress[]
  submissions      AssignmentSubmission[]

  @@unique([moduleId, order])
  @@unique([moduleId, slug])
  @@index([moduleId, status, order])
}

model Assessment {
  id           String               @id @default(uuid())
  moduleId     String               @unique
  title        String
  instructions String
  passMark     Int
  status       ContentStatus        @default(DRAFT)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  module       Module               @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  questions    AssessmentQuestion[]
  attempts     AssessmentAttempt[]
}

model AssessmentQuestion {
  id           String     @id @default(uuid())
  assessmentId String
  order        Int
  prompt       String
  options      Json
  correctIndex Int
  explanation  String
  points       Int        @default(1)
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, order])
  @@index([assessmentId, order])
}

model Enrollment {
  id          String           @id @default(uuid())
  userId      String
  programId   String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  program     Program          @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([programId, status])
}

model LessonProgress {
  userId      String
  lessonId    String
  completedAt DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@id([userId, lessonId])
  @@index([lessonId])
}

model AssessmentAttempt {
  id           String        @id @default(uuid())
  assessmentId String
  userId       String
  answers      Json
  correct      Int
  total        Int
  scorePct     Int
  status       AttemptStatus
  submittedAt  DateTime      @default(now())
  assessment   Assessment    @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, assessmentId, submittedAt])
  @@index([assessmentId, status])
}

model AssignmentSubmission {
  id           String           @id @default(uuid())
  lessonId     String
  userId       String
  response     String
  status       SubmissionStatus @default(SUBMITTED)
  feedback     String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  user         User             @relation("StudentSubmissions", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy   User?            @relation("ReviewerSubmissions", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([userId, lessonId, createdAt])
  @@index([status, createdAt])
}

model Application {
  id                   String            @id @default(uuid())
  programId            String
  fullName             String
  email                String
  phone                String?
  country              String
  churchOrOrganization String?
  ministryRole         String?
  reason               String
  status               ApplicationStatus @default(PENDING)
  adminNotes           String?
  reviewedAt           DateTime?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  program              Program           @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([programId, email])
  @@index([programId, status, createdAt])
}

model DiscussionPost {
  id            String           @id @default(uuid())
  moduleId      String
  authorId      String
  parentId      String?
  body          String
  status        PostStatus       @default(VISIBLE)
  moderatedById String?
  moderatedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  module        Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  author        User             @relation("PostAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  moderatedBy   User?            @relation("PostModerator", fields: [moderatedById], references: [id], onDelete: SetNull)
  parent        DiscussionPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       DiscussionPost[] @relation("PostReplies")

  @@index([moduleId, status, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model Announcement {
  id          String    @id @default(uuid())
  programId   String
  authorId    String
  title       String
  body        String
  publishedAt DateTime  @default(now())
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  program     Program   @relation(fields: [programId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([programId, publishedAt])
}

model Certificate {
  id         String   @id @default(uuid())
  serial     String   @unique
  programId  String
  studentId  String
  issuedById String
  issuedAt   DateTime @default(now())
  program    Program  @relation(fields: [programId], references: [id], onDelete: Restrict)
  student    User     @relation("StudentCertificates", fields: [studentId], references: [id], onDelete: Cascade)
  issuedBy   User     @relation("IssuedCertificates", fields: [issuedById], references: [id], onDelete: Restrict)

  @@unique([programId, studentId])
  @@index([studentId])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
}
